    "name": "BorrowBuddy API",
    "description": "BorrowBuddy - smart borrow and lend platform for college students.\n\nRun **Auth > Login** first. The test script stores the JWT in the `token` collection variable, and later requests inherit it.\n\nDemo accounts (dev profile, password `Password123`): aarav@college.edu, priya@college.edu, rohan@college.edu, sara@college.edu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "itemId", "value": "1", "type": "string" },
    { "key": "requestId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "qrToken", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" },
    { "key": "studentId", "value": "1", "type": "string" }
