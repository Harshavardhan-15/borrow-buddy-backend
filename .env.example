# ---------------------------------------------------------------------------
# BorrowBuddy API environment template
# Copy to .env (never commit .env) and fill in real values.
# For Aiven MySQL, copy aiven.env.example to .env.aiven instead.
# ---------------------------------------------------------------------------

# ---- Backend / Spring ----
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# ---- MySQL (managed database in production) ----
# Local MySQL example:
DB_URL=jdbc:mysql://127.0.0.1:3306/borrowbuddy_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
# Aiven MySQL example (TLS is mandatory):
# DB_URL=jdbc:mysql://<host>:<port>/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=borrowbuddy
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_DDL_AUTO=update

# ---- JWT ----
# Must be at least 32 characters (256 bits). Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ---- Frontend origin (CORS) ----
# The deployed React app origin, e.g. https://borrowbuddy.vercel.app
FRONTEND_URL=http://localhost:5173

# ---- Registration domains (comma separated, no @) ----
ALLOWED_EMAIL_DOMAINS=college.edu

# ---- Uploads ----
# Images are stored in MySQL (stored_images). UPLOAD_DIR is only a fallback for
# files written by older builds.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
IMPORT_DEMO_IMAGES=true

# ---- Email (optional; in-app notifications always work) ----
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Reminders / seed ----
REMINDER_CRON=0 0 8 * * *
SEED_ENABLED=false

# ---- Auth rate limiting (per client IP) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
