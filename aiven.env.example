# ---------------------------------------------------------------------------
# Aiven MySQL environment template
#
# Copy this file to backend\.env.aiven and fill in the real values.
# backend\.env.aiven is git-ignored and must never be committed.
# Run with:  powershell -ExecutionPolicy Bypass -File scripts\run-aiven.ps1
# ---------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Aiven MySQL (Service URI -> JDBC URL)
# mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
DB_URL=jdbc:mysql://<host>:<port>/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=<aiven-user>
DB_PASSWORD=<aiven-password>
DB_POOL_SIZE=10
DB_DDL_AUTO=update

# Generate a unique value in PowerShell:
#   $b = New-Object byte[] 48
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRATION_MS=86400000

FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_EMAIL_DOMAINS=college.edu
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

REMINDER_CRON=0 0 8 * * *
SEED_ENABLED=false
